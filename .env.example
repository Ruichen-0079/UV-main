# AI Companion Runtime environment example.
# Do not put real API keys in this file. Copy to .env for local use.
#
# MVP requirement: chat provider and PostgreSQL database are required.
# Optional providers can be unavailable in development when PROVIDER_ALLOW_MOCKS=true.

# -----------------------------
# Server
# -----------------------------
# Runtime mode: development, test, or production.
NODE_ENV=development

# Fastify bind host.
SERVER_HOST=127.0.0.1

# Fastify bind port.
SERVER_PORT=3000

# Structured log level.
LOG_LEVEL=info

# Allow mock providers when real optional provider config is absent.
PROVIDER_ALLOW_MOCKS=true

# Include raw vendor responses in provider debug fields. Keep false unless debugging locally.
PROVIDER_INCLUDE_RAW_RESPONSES=false

# Force in-memory repository for local smoke tests. Remove or set to postgres for DB-backed memory.
MEMORY_REPOSITORY=memory

# -----------------------------
# Provider Selection
# -----------------------------
# Explicit default provider names used by ProviderRegistry.
DEFAULT_CHAT_PROVIDER=deepseek
DEFAULT_REASONING_PROVIDER=deepseek
DEFAULT_TTS_PROVIDER=xai
DEFAULT_STT_PROVIDER=dashscope
DEFAULT_VISION_PROVIDER=xai
DEFAULT_EMBEDDING_PROVIDER=mock

# -----------------------------
# Database / Cache / Event Bus
# -----------------------------
# Required for MVP memory persistence. Uses PostgreSQL with pgvector.
DATABASE_URL=postgres://companion:companion@localhost:5432/companion

# Redis cache URL. Prepared for cache/session/rate-limit work.
REDIS_URL=redis://localhost:6379

# NATS is optional for now. In-memory event bus is used for MVP.
NATS_URL=nats://localhost:4222
EVENT_BUS_DRIVER=memory

# -----------------------------
# DeepSeek (required for production chat/reasoning)
# -----------------------------
# OpenAI-compatible DeepSeek API base URL.
DEEPSEEK_API_BASEURL=https://api.deepseek.com

# Required when DEFAULT_CHAT_PROVIDER=deepseek or DEFAULT_REASONING_PROVIDER=deepseek in production.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key

# Do not hardcode model names in code; configure them here.
DEEPSEEK_CHAT_MODEL=replace-with-chat-model
DEEPSEEK_REASONING_MODEL=replace-with-reasoning-model

# -----------------------------
# xAI (optional TTS and Vision)
# -----------------------------
# xAI API base URL.
XAI_API_BASEURL=https://api.x.ai/v1

# Optional unless TTS or Vision are enabled without mocks.
XAI_API_KEY=replace-with-xai-api-key

# Text-to-speech model and default voice.
XAI_TTS_MODEL=replace-with-xai-tts-model
XAI_TTS_VOICE=replace-with-xai-voice

# Vision model.
XAI_VISION_MODEL=replace-with-xai-vision-model

# -----------------------------
# Alibaba Cloud DashScope (optional STT)
# -----------------------------
# Optional unless STT is enabled without mocks.
DASHSCOPE_API_KEY=replace-with-dashscope-api-key

# DashScope API base URL.
DASHSCOPE_API_BASEURL=https://dashscope.aliyuncs.com/api/v1

# Speech-to-text model.
DASHSCOPE_STT_MODEL=replace-with-dashscope-stt-model

# -----------------------------
# Embedding Provider (optional for MVP)
# -----------------------------
# Use mock for local development, or openai-compatible for real embeddings.
EMBEDDING_PROVIDER=mock

# OpenAI-compatible embedding API base URL.
EMBEDDING_API_BASEURL=https://example-embedding-provider.test/v1

# Optional unless EMBEDDING_PROVIDER=openai-compatible.
EMBEDDING_API_KEY=replace-with-embedding-api-key

# Embedding model and vector dimensions.
EMBEDDING_MODEL=replace-with-embedding-model
EMBEDDING_DIMENSIONS=1536
