# AI Companion Runtime 环境变量示例
# 复制本文件为 .env 后再填写本地配置。
# 不要在本文件中写入真实 API key。
# secret、API key、Authorization header、token、password 绝不能被日志打印。

# -----------------------------
# Server
# -----------------------------
# 本地开发默认使用 development。
NODE_ENV=development

# Server 监听地址和端口。
SERVER_HOST=127.0.0.1
SERVER_PORT=6121

# 未来 Web dashboard 的开发端口。
WEB_PORT=5173

# -----------------------------
# Database
# -----------------------------
# MVP 必需：PostgreSQL + pgvector 开发数据库。
# 与 infra/docker-compose.yml 中的 development-only 配置保持一致。
DATABASE_URL=postgres://airi:airi_dev_password@localhost:5432/companion

# Redis 用于未来 cache、session、rate-limit 等开发能力。
REDIS_URL=redis://localhost:6379

# NATS 用于未来事件总线和 JetStream 开发能力。
NATS_URL=nats://localhost:4222

# -----------------------------
# DeepSeek
# -----------------------------
# MVP 必需：默认 Chat 和 Reasoning provider。
DEEPSEEK_API_BASEURL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_REASONING_MODEL=

# -----------------------------
# xAI
# -----------------------------
# 可选：TTS 和 Vision 页面实现前可以留空。
XAI_API_BASEURL=https://api.x.ai/v1
XAI_API_KEY=
XAI_TTS_MODEL=
XAI_TTS_VOICE=
XAI_VISION_MODEL=

# -----------------------------
# Alibaba DashScope
# -----------------------------
# 可选：语音输入页面实现前可以留空。
DASHSCOPE_API_BASEURL=
DASHSCOPE_API_KEY=
DASHSCOPE_STT_MODEL=

# -----------------------------
# Embedding
# -----------------------------
# 本地开发默认使用 mock embedding。
EMBEDDING_PROVIDER=mock
EMBEDDING_API_BASEURL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# -----------------------------
# Runtime mode
# -----------------------------
# development 表示 WSL/Docker/pnpm 开发模式，不等同于未来桌面生产模式。
RUNTIME_MODE=development
