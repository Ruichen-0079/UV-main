  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Is Sole Authority",
      "items": [
        "Runtime owns admission, lifecycle sealing/draining, cancellation and stale-result fencing, persistence coordination, finalized-turn states and canonical publish",
        "Handlers, Dashboard, Presentation, Harness, Cognition, Lumi never bypass: transport calls handleUserMessage() only",
        "No second Runtime; no generic ToolOrchestrator; final lifecycle sealing rejects new work"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory Is Evidence, Not Authority",
      "items": [
        "PostgreSQL + pgvector via repository ports and FinalizedIngestion ledger is durable baseline (Linux-first)",
        "Memory retrieves, ranks, dedupes, and validates evidence; never owns persona/relationship truth",
        "Conversation persistence and long-term Memory are separate; ingestion is idempotent, retry/reconcile aware"
      ]
    },
    {
      "dot": "violet",
      "title": "Contracts Stay Stable",
      "items": [
        "Character ABI 2A + Harness 5A-D produce bounded semantic proposals; malformed collapses to MALFORMED diagnostic",
        "Cognition 6A/6G/6H is description-only: capabilityRef opaque, no MCP schema or wire leak, one round via 6J admission",
        "Providers are replaceable via registry; Prompt Builder is provider-neutral; Embodied 7A/7B remain semantic, 7G owns effectId"
      ]
    },
    {
      "dot": "amber",
      "title": "Presentation Never Owns Runtime",
      "items": [
        "Behavior Policy P0>P1>P2>P3 admits only matching Derived Priority + correlation (turn/session epoch) + capability + TTL",
        "7G allocates opaque effectId distinct from cause/correlation; 7I admits via policy veto; 7H fences stale callbacks",
        "CompanionBus validates knownKinds/exactKeys/role loopback; WebSocket ActiveTrace caps 256, drops unsupported/malformed/timeout"
      ]
    }
  ]
