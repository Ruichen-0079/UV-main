# AI Companion Runtime server environment example.
# Do not put real API keys in this file. Copy to .env for local use.
#
# MVP requirement: chat provider is required. Development memory defaults to in-memory.
# Normal development/runtime is real-provider-first. Use PROVIDER_ALLOW_MOCKS=true only for
# tests, CI, or intentional offline development.

NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=6121
LOG_LEVEL=info
PROVIDER_ALLOW_MOCKS=false
MEMORY_REPOSITORY=in-memory
# Optional conversation store override. When unset, MEMORY_REPOSITORY is reused.
# Use postgres for conversation recovery across process restarts.
CONVERSATION_REPOSITORY=in-memory
MEMORY_EXTRACTOR=llm
# MEMORY_EXTRACTOR=llm uses the configured ReasoningProvider only on writeMemory=true turns.
# MEMORY_EXTRACTOR=rule-based keeps deterministic no-token fallback extraction.
DIRECT_CONTEXT_ENABLED=true
DIRECT_CONTEXT_MAX_TURNS=6
DIRECT_CONTEXT_MAX_CHARS=6000
# Direct Context is short-term same-session prompt context. It is not long-term memory.

DEFAULT_CHAT_PROVIDER=deepseek
DEFAULT_REASONING_PROVIDER=deepseek
DEFAULT_TTS_PROVIDER=xai
DEFAULT_STT_PROVIDER=dashscope
DEFAULT_VISION_PROVIDER=xai
DEFAULT_EMBEDDING_PROVIDER=openai-compatible

DATABASE_URL=postgres://yuvi:yuvi_dev_password@localhost:5432/yuvi
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
EVENT_BUS=in-memory
# EVENT_BUS=nats is reserved for future support and is not implemented yet.
DASHBOARD_DEV_TOKEN=
# Optional local development guard for sensitive endpoints. Send as X-YUVI-Dev-Token when set.

DEEPSEEK_API_BASEURL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

XAI_API_BASEURL=https://api.x.ai/v1
XAI_API_KEY=
XAI_TTS_MODEL=
XAI_TTS_VOICE=
XAI_VISION_MODEL=

DASHSCOPE_API_BASEURL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_STT_MODEL=

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_BASEURL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Explicit offline/mock mode:
# PROVIDER_ALLOW_MOCKS=true
# EMBEDDING_PROVIDER=mock
