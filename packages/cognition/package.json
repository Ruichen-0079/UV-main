{
  "name": "@companion/cognition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "check": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --passWithNoTests && pnpm run test:runtime-import",
    "test:runtime-import": "tsc -b tsconfig.json && node --input-type=module -e \"await import('./dist/index.js'); await import('../character-harness/dist/cognition-result.js')\""
  },
  "dependencies": {
    "@companion/character-abi": "workspace:*",
    "@companion/character-harness": "workspace:*",
    "@companion/providers": "workspace:*"
  }
}
