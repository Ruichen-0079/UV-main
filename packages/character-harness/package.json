{
  "name": "@companion/character-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./recovery": {
      "types": "./src/recovery.ts",
      "development": "./src/recovery.ts",
      "import": "./dist/recovery.js"
    },
    "./recovery-supervisor": {
      "types": "./src/recovery-supervisor.ts",
      "development": "./src/recovery-supervisor.ts",
      "import": "./dist/recovery-supervisor.js"
    },
    "./cognition-request": {
      "types": "./src/cognition-request.ts",
      "development": "./src/cognition-request.ts",
      "import": "./dist/cognition-request.js"
    },
    "./cognition-result": {
      "types": "./src/cognition-result.ts",
      "development": "./src/cognition-result.ts",
      "import": "./dist/cognition-result.js"
    },
    "./cognition-section": {
      "types": "./src/cognition-section.ts",
      "development": "./src/cognition-section.ts",
      "import": "./dist/cognition-section.js"
    },
    "./assembly-v2d": {
      "types": "./src/assembly-v2d.ts",
      "development": "./src/assembly-v2d.ts",
      "import": "./dist/assembly-v2d.js"
    },
    "./post-cognition-assembly": {
      "types": "./src/post-cognition-assembly.ts",
      "development": "./src/post-cognition-assembly.ts",
      "import": "./dist/post-cognition-assembly.js"
    },
    "./adapter-request": {
      "types": "./src/adapter-request.ts",
      "development": "./src/adapter-request.ts",
      "import": "./dist/adapter-request.js"
    },
    "./accepted-proposal-instance": {
      "types": "./src/accepted-proposal-instance.ts",
      "development": "./src/accepted-proposal-instance.ts",
      "import": "./dist/accepted-proposal-instance.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "check": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --passWithNoTests && pnpm run test:runtime-import",
    "test:runtime-import": "tsc -b tsconfig.json && node --input-type=module -e \"await import('./dist/cognition-section.js'); await import('./dist/post-cognition-assembly.js'); await import('./dist/adapter-request.js'); await import('./dist/accepted-proposal-instance.js')\""
  },
  "dependencies": {
    "@companion/character-abi": "workspace:*"
  }
}
