{
  "name": "ai-companion-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, event-driven AI companion runtime.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @companion/server dev",
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "pnpm -r test",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset:dev": "bash scripts/db-reset-dev.sh",
    "smoke:postgres": "DATABASE_URL=postgres://airi:airi_dev_password@localhost:5432/companion pnpm db:migrate && MEMORY_REPOSITORY=postgres DATABASE_URL=postgres://airi:airi_dev_password@localhost:5432/companion pnpm smoke"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
